<Window x:Class="BackdropBuddy.Shell.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackdropBuddy"
        Width="640" Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#F1F2F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>

        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"
                             EasingFunction="{StaticResource EaseOutCubic}"/>

            <DoubleAnimation Storyboard.TargetName="MarkGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.5" BeginTime="0:0:0.20" Duration="0:0:1.00"
                             EasingFunction="{StaticResource EaseOutCubic}"/>

            <DoubleAnimation Storyboard.TargetName="AppIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.90"
                             EasingFunction="{StaticResource EaseOutCubic}"/>
            <DoubleAnimation Storyboard.TargetName="IconScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" BeginTime="0:0:0.15" Duration="0:0:1.00"
                             EasingFunction="{StaticResource EaseOutCubic}"/>
            <DoubleAnimation Storyboard.TargetName="IconScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1" BeginTime="0:0:0.15" Duration="0:0:1.00"
                             EasingFunction="{StaticResource EaseOutCubic}"/>

            <DoubleAnimation Storyboard.TargetName="Reticle"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.55" BeginTime="0:0:0.20" Duration="0:0:0.90"
                             EasingFunction="{StaticResource EaseOutCubic}"/>
            <DoubleAnimation Storyboard.TargetName="RetRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" BeginTime="0:0:0.20" Duration="0:0:30"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="WordSub" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.95" Duration="0:0:0.40"
                             EasingFunction="{StaticResource EaseOutCubic}"/>
            <DoubleAnimation Storyboard.TargetName="WordSubShift" Storyboard.TargetProperty="Y"
                             From="4" To="0" BeginTime="0:0:0.95" Duration="0:0:0.40"
                             EasingFunction="{StaticResource EaseOutCubic}"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True" Background="#F1F2F6">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.55,1">
                    <GradientStop Color="#FCFDFE" Offset="0"/>
                    <GradientStop Color="#F5F7FA" Offset="0.45"/>
                    <GradientStop Color="#F1F2F6" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.78,0.12" GradientOrigin="0.78,0.12"
                                     RadiusX="0.9" RadiusY="0.7">
                    <GradientStop Color="#B8FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid IsHitTestVisible="False" Opacity="0.45">
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top"
                       Width="160" Height="520" Margin="0,44,64,0"
                       Stroke="#1E202412" StrokeThickness="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top"
                       Width="100" Height="360" Margin="0,44,252,0"
                       Stroke="#1E202410" StrokeThickness="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#48FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42"
                                     RadiusX="0.64" RadiusY="0.58">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#0A000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="ContentHost">
            <!-- 图标与准星共用同一个中心 -->
            <Grid x:Name="IconStage" Width="648" Height="648"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,-10,0,0">
                <Grid x:Name="Reticle" Opacity="0" IsHitTestVisible="False">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="400" Height="400">
                            <Canvas Width="400" Height="400">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="RetRotate" CenterX="200" CenterY="200"/>
                                </Canvas.RenderTransform>
                                <Path Data="M103.6,314.9 A150,150 0 1 1 296.4,314.9"
                                      Stroke="#1E2024" StrokeThickness="1.2" Fill="{x:Null}" Opacity="0.4"/>
                                <Ellipse Canvas.Left="291.4" Canvas.Top="309.9" Width="10" Height="10"
                                         Fill="#0EB0FC" Opacity="0.75"/>
                            </Canvas>
                            <Ellipse Canvas.Left="149.2" Canvas.Top="129.2" Width="5.6" Height="5.6"
                                     Fill="#C6A15B" Opacity="0.65"/>
                            <Ellipse Canvas.Left="249.2" Canvas.Top="265.2" Width="5.6" Height="5.6"
                                     Fill="#1E2024" Opacity="0.35"/>
                            <Ellipse Canvas.Left="275.2" Canvas.Top="147.2" Width="5.6" Height="5.6"
                                     Fill="#C6A15B" Opacity="0.65"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <Ellipse x:Name="MarkGlow" Width="300" Height="300"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2E0EB0FC" Offset="0"/>
                            <GradientStop Color="#000EB0FC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid x:Name="MarkRoot" Width="220" Height="220"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="AppIcon" Source="Assets/app-icon.png"
                           Width="220" Height="220" Stretch="Uniform"
                           Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="IconScale" ScaleX="0.94" ScaleY="0.94"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <StackPanel x:Name="TextStack" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="175"/>
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="WordSub" Text="L O C A L   T H E M E   E N G I N E"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="10"
                               TextOptions.TextFormattingMode="Display"
                               Foreground="#4D535B" Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="WordSubShift" Y="4"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="StatusBlock" HorizontalAlignment="Center"
                                Margin="0,16,0,0" Opacity="0">
                        <StackPanel x:Name="StatusZh" Orientation="Horizontal" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="StatusEn" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,7,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,44,0,0">
                <TextBlock Text="B A C K D R O P B U D D Y"
                           FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="Bold"
                           Foreground="#1E2024"/>
                <TextBlock Text="T H E M E   M A N A G E R"
                           FontFamily="Cascadia Mono, Consolas" FontSize="9.5"
                           TextOptions.TextFormattingMode="Display"
                           Foreground="#4D535B" Margin="0,4,0,0"/>
            </StackPanel>

            <Border x:Name="Skip" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,40,38,0" Padding="8,5" BorderBrush="Transparent"
                    BorderThickness="1" Background="Transparent" Opacity="0.75" Cursor="Hand">
                <TextBlock Text="跳过  SKIP ▸" FontFamily="Cascadia Mono, Consolas"
                           FontSize="10" TextOptions.TextFormattingMode="Display"
                           Foreground="#7A8088"/>
            </Border>

            <Grid x:Name="Progress" Width="240" Height="3"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,52" Opacity="0.85">
                <Rectangle Height="2" VerticalAlignment="Center" Fill="#1E202418"/>
                <Rectangle Height="2" VerticalAlignment="Center" Fill="#C6A15B"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0.04"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Grid>

        <Rectangle x:Name="LightOut" Fill="#F1F2F6" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
